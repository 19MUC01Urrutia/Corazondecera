<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Corazón de Cera | Velas Artesanales</title>
    <!-- Tailwind CSS para el diseño -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Tipografías de Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Montserrat:wght@300;400;500&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --rosa-corazon: #F4D7D4;
            --crema-fondo: #FFFDF9;
            --cafe-texto: #4A3F35;
            --beige-detalles: #D9C5B2;
        }
        body { 
            font-family: 'Montserrat', sans-serif; 
            background-color: var(--crema-fondo); 
            color: var(--cafe-texto); 
        }
        h1, h2, h3 { font-family: 'Playfair Display', serif; }
        
        .hero-gradient {
            background: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4));
        }
        .btn-hover:hover {
            transform: scale(1.05);
            transition: all 0.3s ease;
        }
    </style>
</head>
<body>

    <!-- Navegación -->
    <nav class="fixed w-full z-50 bg-white/90 backdrop-blur-sm border-b border-pink-100">
        <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
            <div class="text-2xl font-bold tracking-tighter text-rosa-dark">CORAZÓN DE CERA</div>
            <div class="hidden md:flex space-x-8 text-xs uppercase tracking-widest font-medium">
                <a href="#inicio" class="hover:text-pink-400 transition">Inicio</a>
                <a href="#nosotros" class="hover:text-pink-400 transition">Esencia</a>
                <a href="#galeria" class="hover:text-pink-400 transition">Catálogo</a>
                <a href="#contacto" class="hover:text-pink-400 transition">Contacto</a>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <header id="inicio" class="relative h-screen flex items-center justify-center overflow-hidden">
        <!-- Imagen de fondo usando tu ruta local -->
        <img src="hero.jpg" alt="Vela artesanal Corazón de Cera" class="absolute inset-0 w-full h-full object-cover">
        <div class="absolute inset-0 hero-gradient"></div>
        
        <div class="relative z-10 text-center text-white px-4">
            <h1 class="text-5xl md:text-8xl mb-6 drop-shadow-lg">Luz que nace del corazón</h1>
            <p class="text-xl md:text-2xl font-light italic mb-10 opacity-90">Hecho a mano con amor en Jutiapa, Guatemala 📍</p>
            <a href="https://wa.me/502XXXXXXXX" class="btn-hover inline-block bg-[#F4D7D4] text-[#4A3F35] px-10 py-4 rounded-full font-semibold shadow-2xl">
                Ver Catálogo en WhatsApp
            </a>
        </div>
    </header>

    <!-- Sobre Nosotros -->
    <section id="nosotros" class="py-24 px-6">
        <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-16 items-center">
            <div class="relative">
                <div class="absolute -top-4 -left-4 w-full h-full border-2 border-[#D9C5B2] rounded-2xl"></div>
                <img src="sobre-nosotros.jpg" alt="Proceso de creación" class="relative z-10 rounded-2xl shadow-2xl w-full object-cover h-[500px]">
            </div>
            <div>
                <span class="text-pink-400 font-semibold tracking-widest uppercase text-sm">Nuestra Esencia</span>
                <h2 class="text-4xl md:text-5xl mt-4 mb-8 leading-tight">Velas que cuentan historias de calidez.</h2>
                <p class="text-lg leading-relaxed mb-6 opacity-80">
                    En <strong>Corazón de Cera</strong>, convertimos la cera en momentos inolvidables. Cada vela es vertida a mano individualmente, utilizando ingredientes seleccionados para asegurar una quemada limpia y un aroma que abraza tu hogar.
                </p>
                <p class="text-2xl font-serif italic text-pink-500">"Será un placer atenderte!"</p>
            </div>
        </div>
    </section>

    <!-- Galería / Productos -->
    <section id="galeria" class="py-24 bg-[#FDF4F2]">
        <div class="max-w-7xl mx-auto px-6">
            <div class="text-center mb-16">
                <h2 class="text-4xl md:text-5xl mb-4">Inspiración para tu hogar</h2>
                <p class="opacity-60">Explora nuestras creaciones artesanales más recientes</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                <!-- Producto 1 -->
                <div class="group cursor-pointer">
                    <div class="overflow-hidden rounded-xl mb-4 shadow-lg aspect-[3/4]">
                        <img src="vela-vidrio.jpg" alt="Vela aromática" class="w-full h-full object-cover group-hover:scale-110 transition duration-700">
                    </div>
                    <h3 class="text-xl font-bold">Vela en Vidrio</h3>
                    <p class="text-sm opacity-70 italic">Con flores secas naturales</p>
                </div>

                <!-- Producto 2 -->
                <div class="group cursor-pointer">
                    <div class="overflow-hidden rounded-xl mb-4 shadow-lg aspect-[3/4]">
                        <img src="vela-decorativa.jpg" alt="Vela decorativa" class="w-full h-full object-cover group-hover:scale-110 transition duration-700">
                    </div>
                    <h3 class="text-xl font-bold">Diseños de Tendencia</h3>
                    <p class="text-sm opacity-70 italic">Formas esculturales modernas</p>
                </div>

                <!-- Producto 3 -->
                <div class="group cursor-pointer">
                    <div class="overflow-hidden rounded-xl mb-4 shadow-lg aspect-[3/4]">
                        <img src="set-regalo.jpg" alt="Set de regalo" class="w-full h-full object-cover group-hover:scale-110 transition duration-700">
                    </div>
                    <h3 class="text-xl font-bold">Sets de Regalo</h3>
                    <p class="text-sm opacity-70 italic">Para eventos y celebraciones</p>
                </div>

                <!-- Producto 4 -->
                <div class="group cursor-pointer">
                    <div class="overflow-hidden rounded-xl mb-4 shadow-lg aspect-[3/4]">
                        <img src="empaque.jpg" alt="Empaque artesanal" class="w-full h-full object-cover group-hover:scale-110 transition duration-700">
                    </div>
                    <h3 class="text-xl font-bold">Empaque con Amor</h3>
                    <p class="text-sm opacity-70 italic">Personalizado y eco-amigable</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer id="contacto" class="bg-[#4A3F35] text-white py-20 px-6">
        <div class="max-w-4xl mx-auto text-center">
            <h2 class="text-4xl mb-6">¿Lista para iluminar tu espacio?</h2>
            <p class="text-lg opacity-80 mb-10">Estamos en Jutiapa, Guatemala, listos para enviarte un pedacito de nuestro corazón.</p>
            
            <div class="flex flex-col md:flex-row justify-center items-center gap-6 mb-12">
                <a href="https://wa.me/502XXXXXXXX" class="bg-[#F4D7D4] text-[#4A3F35] px-8 py-3 rounded-full font-bold w-full md:w-auto hover:bg-white transition">
                    Escríbenos por WhatsApp
                </a>
                <a href="https://www.instagram.com/_c0razondecera/" target="_blank" class="border border-white/30 px-8 py-3 rounded-full w-full md:w-auto hover:bg-white/10 transition">
                    Síguenos en Instagram
                </a>
            </div>
            
            <div class="pt-10 border-t border-white/10 opacity-50 text-sm">
                <p>© 2024 CORAZÓN DE CERA - Velas Artesanales</p>
                <p>Hecho con ❤️ en Jutiapa, Guatemala</p>
            </div>
        </div>
    </footer>

</body>
</html>
